{
  "name": "nanologic",
  "productName": "NanoLogic",
  "version": "0.1.0",
  "description": "Verilog editor, simulator and virtual DE10-Lite board for students, with export to Intel Quartus Prime Lite 17.1.",
  "author": "Ali Mleahat",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "spike": "vitest run tests/unit/reference-project.test.ts",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux dir"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@veriflow/iverilog-wasm": "0.1.4",
    "@yowasp/yosys": "0.70.1258"
  },
  "devDependencies": {
    "@monaco-editor/react": "4.7.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "42.11.18",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.12",
    "monaco-editor": "0.54.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-resizable-panels": "3.0.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}

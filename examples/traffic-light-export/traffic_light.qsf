# Generated by NanoLogic for the Terasic DE10-Lite.
# Open traffic_light.qpf in Quartus Prime Lite 17.1, then run Processing > Start Compilation.
# Pin locations and I/O standards come from the DE10-Lite User Manual.

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY MainCode
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 17.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "09:00:00  OCTOBER 30, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "17.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85

# Source files
set_global_assignment -name VERILOG_FILE src/BCD7Seg.v
set_global_assignment -name VERILOG_FILE src/BinaryBCD.v
set_global_assignment -name VERILOG_FILE src/ClockDivider.v
set_global_assignment -name VERILOG_FILE src/Comparator4.v
set_global_assignment -name VERILOG_FILE src/CoreLogic.v
set_global_assignment -name VERILOG_FILE src/CounterUnit.v
set_global_assignment -name VERILOG_FILE src/Decoder.v
set_global_assignment -name VERILOG_FILE src/FourBitFullAdder.v
set_global_assignment -name VERILOG_FILE src/MainCode.v
set_global_assignment -name VERILOG_FILE src/Mux.v
set_global_assignment -name VERILOG_FILE src/Mux2Way4.v
set_global_assignment -name VERILOG_FILE src/OneBitFullAdder.v
set_global_assignment -name VERILOG_FILE src/SevenSegDisplay.v
set_global_assignment -name VERILOG_FILE src/Subtractor.v
set_global_assignment -name SDC_FILE traffic_light.sdc

# Pin assignments
set_location_assignment PIN_P11 -to CLK_50MHz
set_location_assignment PIN_A7 -to rst_n
set_location_assignment PIN_B8 -to pedestrian_btn
set_location_assignment PIN_C18 -to HexH[0]
set_location_assignment PIN_D18 -to HexH[1]
set_location_assignment PIN_E18 -to HexH[2]
set_location_assignment PIN_B16 -to HexH[3]
set_location_assignment PIN_A17 -to HexH[4]
set_location_assignment PIN_A18 -to HexH[5]
set_location_assignment PIN_B17 -to HexH[6]
set_location_assignment PIN_C14 -to HexL[0]
set_location_assignment PIN_E15 -to HexL[1]
set_location_assignment PIN_C15 -to HexL[2]
set_location_assignment PIN_C16 -to HexL[3]
set_location_assignment PIN_E16 -to HexL[4]
set_location_assignment PIN_D17 -to HexL[5]
set_location_assignment PIN_C17 -to HexL[6]
set_location_assignment PIN_A10 -to Green
set_location_assignment PIN_A8 -to Red
set_location_assignment PIN_A9 -to Amber
set_location_assignment PIN_B11 -to LEDR9

# I/O standards
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLK_50MHz
set_instance_assignment -name IO_STANDARD "3.3 V SCHMITT TRIGGER" -to rst_n
set_instance_assignment -name IO_STANDARD "3.3 V SCHMITT TRIGGER" -to pedestrian_btn
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HexH[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HexH[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HexH[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HexH[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HexH[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HexH[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HexH[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HexL[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HexL[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HexL[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HexL[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HexL[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HexL[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HexL[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Green
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Red
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Amber
